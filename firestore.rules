rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 20
        && name.matches('^[a-z0-9._]+$')
        && !name.matches('^[._]')
        && !name.matches('[._]$')
        && !name.matches('.*[._]{2,}.*');
    }

    // ===== USERNAMES COLLECTION =====
    match /usernames/{normalized} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource.data.userId == request.auth.uid
            || resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ===== PROBLEMS COLLECTION (read-only for all auth users) =====
    match /problems/{problemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid in ['admin']; // Admin write only

      match /discussion/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(request.resource.data.userId);
      }
    }

    // ===== USERS COLLECTION =====
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches('^u_[a-z0-9]+$')
        && isValidUsername(request.resource.data.username);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.publicId == resource.data.publicId
        && (request.resource.data.username == resource.data.username
            || (request.resource.data.username is string
                && isValidUsername(request.resource.data.username)));

      match /combatLogs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /gameHistory/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) || (isAuthenticated() && request.auth.uid == friendId);
        allow update, delete: if isOwner(userId);
      }

      match /friendRequests/{reqId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated()
          && request.resource.data.fromUserId == request.auth.uid;
        allow update, delete: if isOwner(userId);
      }

      match /blocked/{blockedUserId} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId)
          && blockedUserId == request.resource.data.blockedUserId;
        allow update: if false;
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated()
          && request.resource.data.userId == notifId.split('_')[0]
          || request.resource.data.userId == userId;
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['read']);
        allow delete: if isOwner(userId);
      }

      // ===== PRACTICE PROGRESS =====
      match /practiceProgress/{problemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      // ===== SAVED CODE =====
      match /savedCode/{problemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ===== SUBMISSIONS =====
      match /submissions/{submissionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // ===== RECENTLY VIEWED =====
      match /recentlyViewed/{problemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      // ===== ARENA SETTINGS =====
      match /arenaSettings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }

    // ===== ROOMS =====
    match /gameRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() == 6
        && request.resource.data.status == 'waiting';
      allow update: if isAuthenticated()
        && (
          request.auth.uid == resource.data.hostId
          || (resource.data.status == 'waiting'
              && request.auth.uid in request.resource.data.players)
        );
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.hostId;
    }

    // ===== BATTLES =====
    match /battles/{battleId} {
      allow read: if isAuthenticated();

      function isPlayer(uid) {
        return resource.data.players != null
          && resource.data.players[0].userId == uid
          || resource.data.players[1].userId == uid;
      }

      function isValidPhaseTransition() {
        let phases = ['countdown', 'coding', 'submitting', 'scoring', 'finished'];
        let current = resource.data.phase;
        let next = request.resource.data.phase;
        let ci = phases.indexOf(current);
        let ni = phases.indexOf(next);
        return ni >= 0 && ni >= ci;
      }

      allow create: if isAuthenticated()
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.resource.data.players[0].userId == request.auth.uid
        && request.resource.data.phase == 'countdown'
        && request.resource.data.status == 'active';

      allow update: if isAuthenticated()
        && isPlayer(request.auth.uid)
        && isValidPhaseTransition()
        && request.resource.data.players.size() == 2
        && request.resource.data.players[0].userId == resource.data.players[0].userId
        && request.resource.data.players[1].userId == resource.data.players[1].userId
        && request.resource.data.problemId == resource.data.problemId;

      allow delete: if false;
    }

    // ===== MATCHMAKING =====
    match /matchmaking/{docId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(docId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['waiting', 'searching'];
      allow update: if isOwner(docId);
      allow delete: if isOwner(docId);
    }

    // ===== LEADERBOARD =====
    match /leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ===== MATCHES (immutable records) =====
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 2;
      allow update, delete: if false;
    }
  }
}
