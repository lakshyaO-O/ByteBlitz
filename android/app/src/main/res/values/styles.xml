<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark theme matching DevRann design -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#28f7a5</item>
        <item name="colorPrimaryDark">#05070f</item>
        <item name="colorAccent">#28f7a5</item>
        <item name="android:windowBackground">#05070f</item>
        <item name="android:statusBarColor">#05070f</item>
        <item name="android:navigationBarColor">#05070f</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#05070f</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#05070f</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
