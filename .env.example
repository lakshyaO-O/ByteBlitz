# Firebase Configuration (Get from Firebase Console > Project Settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (for server-side API routes - get from Firebase Console > Project Settings > Service accounts)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Sentry Error Monitoring (optional - set for production error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AI (for GenKit AI flows - only needed server-side)
GEMINI_API_KEY=your_gemini_api_key_here

# Code Execution Backend (choose one)
# Option 1: Judge0 CE (recommended — self-hosted via Docker)
#   See infra/judge0/docker-compose.yml for the full deployment.
#   Set JUDGE0_PORT in infra/judge0/.env.judge0 (default: 3000).
#   URL format: http://<host>:<port>/api/v1
#   Example (local Docker): http://localhost:3000/api/v1
#   Example (VPS):          http://10.0.0.1:3000/api/v1
JUDGE0_API_URL=
# Auth token from JUDGE0_AUTH_TOKEN in infra/judge0/.env.judge0
JUDGE0_API_KEY=

# Option 2: Piston (alternative self-hosted: https://github.com/engineer-man/piston)
# URL to the Piston execute endpoint, e.g. http://localhost:2000/execute
# Piston requires no auth key.
PISTON_API_URL=

# Rate limiting for judge execution API (max requests per 60s window per user)
JUDGE_RATE_LIMIT=10
