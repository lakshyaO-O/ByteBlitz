# Firebase Configuration (Get from Firebase Console > Project Settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (for server-side API routes - get from Firebase Console > Project Settings > Service accounts)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AI (for GenKit AI flows - only needed server-side)
GEMINI_API_KEY=your_gemini_api_key_here

# Code Execution Backend (choose one)
# Option 1: Piston (self-hosted: https://github.com/engineer-man/piston)
# Set the URL to your Piston API endpoint (no longer defaults)
PISTON_API_URL=

# Option 2: Judge0 CE (self-hosted via Docker: https://github.com/judge0/judge0)
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Rate limiting for judge execution API (max requests per 60s window per user)
JUDGE_RATE_LIMIT=10
