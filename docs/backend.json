
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Store statistical data and ELO for each user.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "rating": { "type": "number" },
        "highestRating": { "type": "number" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "draws": { "type": "number" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "rank": { "type": "number" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["username", "rating"]
    },
    "Problem": {
      "title": "Problem",
      "description": "Coding challenge metadata.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "category": { "type": "string" },
        "points": { "type": "number" },
        "successRate": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "CombatLog": {
      "title": "Combat Log",
      "description": "Record of past battles between users.",
      "type": "object",
      "properties": {
        "opponentId": { "type": "string" },
        "opponentName": { "type": "string" },
        "result": { "type": "string", "enum": ["WIN", "LOSS"] },
        "eloChange": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User specific profile data."
    },
    "/users/{userId}/combatLogs/{logId}": {
      "schema": "CombatLog",
      "description": "History of battles for a specific user."
    },
    "/problems/{problemId}": {
      "schema": "Problem",
      "description": "Global collection of coding problems."
    }
  }
}
