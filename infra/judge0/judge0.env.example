# ─── Judge0 CE Configuration ────────────────────────────────────────────
# Copy to .env and fill in secrets before running docker compose up.

# --- Authentication ---
# Generate with: openssl rand -hex 32
# This token is used to authenticate DevRann API requests to Judge0.
JUDGE0_AUTH_TOKEN=change_me_generate_with_openssl_rand_hex_32

# --- PostgreSQL ---
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=change_me_strong_postgres_password

# --- Redis ---
REDIS_PASSWORD=change_me_strong_redis_password

# --- Judge0 Server ---
# Port the Judge0 API listens on (host side).
JUDGE0_PORT=3000

# --- Resource Limits per Container ---
POSTGRES_MEM_LIMIT=512M
REDIS_MEM_LIMIT=256M
SERVER_MEM_LIMIT=1G
WORKERS_MEM_LIMIT=2G

# --- Performance Tuning ---
# Set CPU_COUNT to match your host CPU cores.
CPU_COUNT=4
# Maximum number of submissions the queue will accept.
MAX_QUEUE_SIZE=200
# Number of concurrent worker threads processing submissions.
CONCURRENCY=4

# --- Rails Environment ---
# Use 'production' for VPS/cloud, 'development' for local.
RAILS_ENV=production
